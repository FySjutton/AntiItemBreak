{
	"schemaVersion": 1,
	"id": "antiitembreak",
	"version": "${version}",
	"name": "Anti Item Break",
	"description": "Prevents accidental item destruction by disabling the item once it reaches 1 durability.",
	"authors": [
		"Fy17"
	],
	"contact": {
		"issues": "https://discord.gg/6gBT2CgqQj",
		"sources": "https://github.com/FySjutton/AntiItemBreak"
	},
	"license": "Fy's Projects License",
	"icon": "assets/antiitembreak/mod_icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"avox.antiitembreak.AntiItemBreak"
		],
		"modmenu": [
          "avox.antiitembreak.config.ModMenuIntegration"
		]
	},
	"mixins": [
      "antiitembreak.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": ">=26.1-",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": ">=18.0.0-"
	},
	"custom": {
		"modmenu": {
			"links": {
				"avox.antiitembreak.discord": "https://discord.gg/V2BXH2q6Rq"
			},
			"update_checker": true
		}
	}
}